{
  "manifest_version": 3,
  "name": "Qwen3-TTS 网页朗读",
  "version": "0.1.1",
  "description": "使用本机 Qwen3-TTS 朗读普通网页中的选中文字。",
  "permissions": [
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Qwen3-TTS 网页朗读"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "reading-queue.js",
        "page-reader.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
